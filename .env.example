# Valeurs de DÉVELOPPEMENT uniquement — aucune n'est un vrai secret.
# Optionnel : sans .env, docker-compose.yml utilise ces mêmes valeurs par défaut.
# Pour personnaliser : cp .env.example .env
POSTGRES_USER=nightfall
POSTGRES_PASSWORD=nightfall_dev_only
POSTGRES_DB=nightfall
PORT=3000
DATABASE_URL=postgres://nightfall:nightfall_dev_only@db:5432/nightfall
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=2h
CORS_ORIGIN=http://localhost:5173